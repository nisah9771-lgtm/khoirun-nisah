<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f5f6f8;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 12px;
        }

        .container {
            width: 100%;
            max-width: 430px;
            color: #1c1e21;
        }

        .back {
            font-size: 22px;
            color: #606770;
            margin-bottom: 8px;
            cursor: pointer;
        }

        .meta {
            font-size: 13px;
            color: #1877f2;
            margin-bottom: 8px;
            font-weight: 500;
        }

        h2 {
            font-size: 22px;
            margin-bottom: 6px;
        }

        .description {
            font-size: 13px;
            color: #65676b;
            margin-bottom: 20px;
        }

        .row {
            display: flex;
            gap: 10px;
        }

        .input-box {
            width: 100%;
            height: 42px;
            border: 1px solid #ccd0d5;
            border-radius: 9px;
            padding: 0 12px;
            font-size: 13px;
            background: white;
            outline: none;
            margin-bottom: 12px;
        }

        .input-box:focus,
        select:focus {
            border-color: #1877f2;
        }

        .label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin: 5px 0 7px;
            color: #333;
        }

        .date-row {
            display: flex;
            gap: 8px;
        }

        select {
            width: 100%;
            height: 42px;
            border: 1px solid #ccd0d5;
            border-radius: 9px;
            padding: 0 10px;
            background: white;
            color: #555;
            outline: none;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .small-text {
            font-size: 10px;
            line-height: 1.5;
            color: #65676b;
            margin: 2px 0 14px;
        }

        .small-text a {
            color: #1b74e4;
            text-decoration: none;
            font-weight: 500;
        }

        .submit-btn {
            width: 100%;
            height: 43px;
            border: none;
            border-radius: 22px;
            background: linear-gradient(90deg, #1877f2, #1464c4);
            color: white;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 6px;
            box-shadow: 0 2px 5px rgba(24, 119, 242, 0.25);
        }

        .submit-btn:hover {
            opacity: 0.9;
        }

        .login-btn {
            width: 100%;
            height: 42px;
            border: none;
            border-radius: 20px;
            background: #eceef1;
            color: #333;
            margin-top: 10px;
            font-size: 12px;
            cursor: pointer;
        }

        @media (max-width: 400px) {
            h2 {
                font-size: 20px;
            }

            .date-row {
                gap: 5px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="back">‹</div>

        <div class="meta">∞ Meta</div>

        <h2>Get started with Facebook</h2>

        <p class="description">
            Facebook, easily and securely.
        </p>

        <div class="row">
            <input type="text" class="input-box" placeholder="First name">
            <input type="text" class="input-box" placeholder="Surname">
        </div>

        <label class="label">Date of birth ⓘ</label>

        <div class="date-row">
            <select>
                <option>Day</option>
                <option>1</option>
                <option>2</option>
                <option>3</option>
            </select>

            <select>
                <option>Month</option>
                <option>January</option>
                <option>February</option>
                <option>March</option>
            </select>

            <select>
                <option>Year</option>
                <option>2010</option>
                <option>2011</option>
                <option>2012</option>
            </select>
        </div>

        <label class="label">Gender ⓘ</label>

        <select>
            <option>Select your gender</option>
            <option>Female</option>
            <option>Male</option>
            <option>Prefer not to say</option>
        </select>

        <label class="label">Mobile number or email address</label>
        <input type="text" class="input-box"
               placeholder="Mobile number or email address">

        <p class="small-text">
            You may receive notifications from us.
            <a href="#">Learn why we ask for your contact information</a>
        </p>

        <label class="label">Password</label>
        <input type="password" class="input-box"
               placeholder="Password">

        <p class="small-text">
            People who use our service may have uploaded your contact
            information to Facebook or Instagram.
        </p>

        <p class="small-text">
            By tapping Submit, you agree to Facebook's
            <a href="#">Terms</a>, <a href="#">Privacy Policy</a>,
            and <a href="#">Cookies Policy</a>.
        </p>

        <p class="small-text">
            The Privacy Policy describes the ways we use this information
            to provide and improve our services.
        </p>

        <button class="submit-btn">Submit</button>

        <button class="login-btn">I already have an account</button>

    </div>

</body>
</html>